# ===== Bắt buộc khi truy cập từ ngoài máy =====
# Mật khẩu đăng nhập. Tốt hơn: dùng YT_PASSWORD_HASH (sinh bằng: docker compose run --rm app python -m app.hashpw)
YT_PASSWORD=doi-mat-khau-nay
# YT_PASSWORD_HASH=

# Chạy sau reverse proxy (Caddy/Tailscale Serve): tin header X-Forwarded-* để lấy IP thật và scheme https
YT_TRUST_PROXY=1

# ===== Tùy chọn =====
# Tag image Docker Hub (lanntxyz/yt-dl): latest, một version (vd. 1.2.3) hoặc sha-xxxxxxx để ghim
# YT_IMAGE_TAG=latest

# Thư mục dữ liệu trên máy chủ (SSD/USB khuyến nghị) và cổng nội bộ
# YT_DATA_HOST_DIR=/mnt/ssd/yt-mp3
# YT_PORT=8000

# Tên miền cho profile https (Caddy)
# YT_DOMAIN=mp3.example.com

# Số job tải song song (Pi 4: giữ 1)
YT_CONCURRENCY=1

# Dọn dẹp: xóa file sau N ngày (0 = không xóa) và/hoặc giới hạn tổng dung lượng audio (GB, 0 = không giới hạn)
YT_RETENTION_DAYS=30
YT_MAX_STORAGE_GB=0

# Sao lưu DB: giữ N bản, mỗi N giờ
YT_BACKUP_KEEP=7
YT_BACKUP_INTERVAL_HOURS=24

# Kiểm tra bản yt-dlp mới mỗi N giờ (0 = tắt)
YT_UPDATE_CHECK_HOURS=24

# Định danh gửi kèm Web Push (không phải email thật của bạn nếu không muốn)
# YT_VAPID_SUBJECT=mailto:admin@example.com
